{{!
    @template local_alerthub/channels

    Channels of the hub, with the test button.

    Example context (json):
    {
        "haschannels": true,
        "channels": [{"id": 1, "name": "Team", "type": "Moodle message", "enabled": true, "rules": 2, "editurl": "#",
            "deleteurl": "#", "testurl": "#", "sesskey": "x"}],
        "types": [{"label": "Moodle message", "url": "#"}]
    }
}}
<div class="local_alerthub-channels">
    <div class="mb-3">
        {{#types}}<a class="btn btn-primary me-2" href="{{url}}">{{#str}} addchanneltype, local_alerthub, {{label}} {{/str}}</a>{{/types}}
    </div>
    {{#haschannels}}
    <table class="table table-sm generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} name {{/str}}</th>
                <th scope="col">{{#str}} channeltype, local_alerthub {{/str}}</th>
                <th scope="col">{{#str}} enabled, local_alerthub {{/str}}</th>
                <th scope="col">{{#str}} rules, local_alerthub {{/str}}</th>
                <th scope="col">{{#str}} actions {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#channels}}
            <tr>
                <td>{{name}}</td>
                <td>{{type}}</td>
                <td>{{#enabled}}{{#str}} yes {{/str}}{{/enabled}}{{^enabled}}{{#str}} no {{/str}}{{/enabled}}</td>
                <td>{{rules}}</td>
                <td>
                    <form method="post" action="{{testurl}}" class="d-inline">
                        <input type="hidden" name="action" value="test">
                        <input type="hidden" name="id" value="{{id}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-sm btn-outline-primary">{{#str}} sendtest, local_alerthub {{/str}}</button>
                    </form>
                    <a class="btn btn-sm btn-outline-secondary" href="{{editurl}}">{{#str}} edit {{/str}}</a>
                    <a class="btn btn-sm btn-outline-danger" href="{{deleteurl}}">{{#str}} delete {{/str}}</a>
                </td>
            </tr>
            {{/channels}}
        </tbody>
    </table>
    {{/haschannels}}
    {{^haschannels}}<p class="text-muted">{{#str}} nochannels, local_alerthub {{/str}}</p>{{/haschannels}}
</div>
